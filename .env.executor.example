# ========================================================================
# AUTO-TRADING EXECUTOR CONFIGURATION (5€ YOLO MODE)
# ========================================================================
# Copy this file to .env and fill in your values
# WARNING: Keep your PRIVATE_KEY secret! Never commit .env to git!
# ========================================================================

# ── Auto-Trading Control ────────────────────────────────────────────────
# START WITH DRY-RUN=true TO TEST WITHOUT REAL TRADES!
AUTO_TRADING_ENABLED=false  # Set to 'true' when ready to trade
EXECUTOR_DRY_RUN=true       # Set to 'false' for real trading

# ── Wallet Configuration ────────────────────────────────────────────────
# Get your private key from MetaMask:
# Settings → Security & Privacy → Export Private Key
# ⚠️ NEVER SHARE THIS! Use a DEDICATED wallet with only 5€!
PRIVATE_KEY=your_private_key_here_without_0x_prefix
PROXY_WALLET=0xYourWalletAddressHere

# ── Copy Strategy (Optimized for 5€) ───────────────────────────────────
# Whale trades $1000 → You copy 5% = $50... but capped at your balance!
TRADE_MULTIPLIER=0.05              # Copy 5% of whale trade size
MIN_ORDER_SIZE_USD=1.0             # Polymarket minimum ($1)
MAX_POSITION_SIZE_USD=2.0          # Max per position ($2 = 40% of 5€)

# ── Safety Limits (STRICT for micro-capital) ───────────────────────────
MAX_DAILY_LOSS_USD=3.0             # Stop after -$3/day (60% of capital)
MAX_TRADES_PER_DAY=3               # Max 3 trades/day (avoid burning capital)
MAX_TRADES_PER_HOUR=1              # Max 1 trade/hour (anti-spam)
RETRY_LIMIT=3                      # Retry failed orders 3x max

# ── Whale Quality Filters (VERY STRICT) ────────────────────────────────
# Only copy the BEST whales to maximize chances with limited capital
EXECUTOR_MIN_WHALE_SCORE=0.80      # Top 20% whales only
EXECUTOR_MIN_CONVICTION=0.75       # High conviction (75%+ redeem rate)
EXECUTOR_MIN_WHALE_TRADE_SIZE=1000.0  # Whale must trade $1000+ (serious signal)

# ── Executor Performance ────────────────────────────────────────────────
EXECUTOR_CHECK_INTERVAL_SEC=1.0    # Check for new trades every 1 second

# ========================================================================
# EXISTING BOT CONFIGURATION (keep your current values)
# ========================================================================

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/polymarket_bot

# ── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Polymarket API ──────────────────────────────────────────────────────
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_DATA_HOST=https://data-api.polymarket.com
CHAIN_ID=137
SIGNATURE_TYPE=0

# ========================================================================
# QUICK START GUIDE
# ========================================================================
#
# 1. PREPARE YOUR WALLET (10 min)
#    - Create a NEW Polygon wallet (MetaMask)
#    - Send 5 USDC + 0.5 MATIC (~$5.30 total)
#    - Export private key (Settings → Export Private Key)
#
# 2. CONFIGURE THIS FILE (5 min)
#    - Copy to .env: cp .env.executor.example .env
#    - Fill PRIVATE_KEY and PROXY_WALLET
#    - Keep AUTO_TRADING_ENABLED=false
#    - Keep EXECUTOR_DRY_RUN=true
#
# 3. TEST IN DRY-RUN (1-2 days)
#    - Run: python main.py
#    - Watch logs for "🎭 DRY-RUN" trades
#    - Verify whale filtering works
#    - Check trade sizing is correct
#
# 4. ENABLE REAL TRADING (when ready)
#    - Set AUTO_TRADING_ENABLED=true
#    - Set EXECUTOR_DRY_RUN=false
#    - Run: python main.py
#    - Monitor closely for first few trades!
#
# ========================================================================
# EXPECTED BEHAVIOR (5€ capital)
# ========================================================================
#
# Day 1:
#   - Whale (score 0.94) buys $2000 → Bot copies $1.50 (capped)
#   - Whale (score 0.82) buys $1500 → Bot copies $1.50
#   - Balance: $2.00 cash + $3.00 in positions = $5.00 total
#
# Scenario A (GOOD): Markets resolve YES
#   - Positions worth $4.50 → +$1.50 profit (30% ROI) 🚀
#
# Scenario B (BAD): Markets resolve NO
#   - Positions worth $0.50 → -$2.50 loss (50% loss) 💸
#
# Scenario C (MIXED): 1 WIN, 1 LOSS
#   - Portfolio = $3.50 → -$1.50 loss (30% loss) 😐
#
# ========================================================================
# SAFETY REMINDERS
# ========================================================================
#
# ⚠️ Use a DEDICATED wallet (not your main wallet)
# ⚠️ Only deposit what you can afford to lose ($5-10 max)
# ⚠️ Test in DRY-RUN first (at least 1-2 days)
# ⚠️ Monitor the bot actively for first 24h
# ⚠️ No stop-loss (you must exit manually if needed)
# ⚠️ Whales can be wrong - past performance ≠ future results
#
# ========================================================================
