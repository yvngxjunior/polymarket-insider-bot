# ── Polymarket ────────────────────────────────────────────────────────
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_DATA_HOST=https://data-api.polymarket.com
PRIVATE_KEY=your_private_key_here
PROXY_WALLET=your_proxy_wallet_address
CHAIN_ID=137
SIGNATURE_TYPE=0

# Optional: Polymarket Builder API (for high-frequency trading)
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# Optional: HTTP Proxy (for geo-restricted regions like France)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=socks5://127.0.0.1:1080

# ── Telegram ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./polyinsider.db
REDIS_URL=redis://localhost:6379/0

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Bot Core ──────────────────────────────────────────────────────────
SCAN_INTERVAL=3
MAX_TRADE_AMOUNT=50.0
MIN_WIN_RATE=0.70
MIN_TRADES_COUNT=15
WHALE_THRESHOLD=500.0
DRY_RUN=true

# ── Capital ───────────────────────────────────────────────────────────
INITIAL_CAPITAL=500.0

# ── Risk Management ───────────────────────────────────────────────────
MAX_POSITION_PCT=0.10
MAX_PRICE=0.90
MIN_PRICE=0.05
MAX_POSITIONS=10
DAILY_LOSS_LIMIT_PCT=0.15
DRAWDOWN_LIMIT_PCT=0.25
KELLY_FRACTION=0.25
CONVERGENCE_BOOST=1.5

# ── Position Sizer ────────────────────────────────────────────────────
MIN_TRADE_USDC=2.0
KELLY_FRACTION_SIZER=0.25

# ── Conviction Filters ────────────────────────────────────────────────
MIN_SOURCE_BET_USDC=50.0
MIN_WALLET_SCORE=0.65
MAX_CONSECUTIVE_LOSSES=3

# ── Whale Keyword Filter ──────────────────────────────────────────────
# CSV de mots-clés à exclure des Whale Alerts (sports, crypto daily)
# Laisser vide = liste par défaut (voir config.py DEFAULT_NOISE_KEYWORDS)
# Pour désactiver complètement: WHALE_KEYWORDS_BLACKLIST=__none__
WHALE_KEYWORDS_BLACKLIST=

# ── Whale Exit Tracking (v3.3) ────────────────────────────────────────
# Track REDEEM/SELL events from whales
WHALE_EXIT_TRACKING=true
# Alert when whale exits a market you hold
WHALE_EXIT_ALERT=true
# ⚠️ DANGER: Auto-exit when whale sells (disabled by default)
WHALE_AUTO_EXIT=false
# Time window (hours) to track exits after entry
WHALE_EXIT_WINDOW_HOURS=6
# Minimum whale score to trigger exit alerts (avoid noise)
WHALE_EXIT_MIN_SCORE=0.70

# ── Position Sizer Tiered (v2.7) ──────────────────────────────────────
# Multiplicateurs dégressifs selon taille trade source
# Format: "min-max:mult,min+:mult" (USD)
# Exemple: TIERED_MULTIPLIERS=1-50:1.0,50-500:0.3,500-5000:0.05,5000+:0.01
# Laisser vide = Kelly pur
TIERED_MULTIPLIERS=

# ── Arbitrage Cross-Platform ──────────────────────────────────────────
ARB_ENABLED=true
ARB_MIN_PROFIT_PCT=0.03

# ── Market Scanner ────────────────────────────────────────────────────
MARKET_SCAN_ENABLED=true
MARKET_SCAN_MAX_MARKETS=5000
MARKET_SCAN_EVERY_N_LOOPS=100

# ── LLM Agent (optionnel) ─────────────────────────────────────────────
LLM_ENABLED=false
OPENAI_API_KEY=your_openai_api_key
NEWS_API_KEY=your_news_api_key
LLM_MIN_CONFIDENCE=0.75
LLM_SCAN_EVERY_N_LOOPS=50
LLM_TOP_MARKETS=5

# ── Wallet Whitelist / Blacklist ──────────────────────────────────────
# CSV d'adresses (bypass filtres)
WALLET_WHITELIST=
WALLET_BLACKLIST=

# ── Health Monitor ────────────────────────────────────────────────────
HEALTH_SILENCE_THRESHOLD_MIN=30
HEALTH_CHECK_INTERVAL_SEC=300
HEALTH_ALERT_COOLDOWN_MIN=60
