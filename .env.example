# ==============================
# POLYMARKET CONFIG
# ==============================
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_DATA_HOST=https://data-api.polymarket.com

# Ton wallet Polygon
PRIVATE_KEY=0xyour_private_key_here
PROXY_WALLET=0xyour_proxy_wallet_here
CHAIN_ID=137

# ==============================
# TELEGRAM BOT
# ==============================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ==============================
# DATABASE
# ==============================
DATABASE_URL=postgresql://user:password@localhost:5432/polymarket_bot
REDIS_URL=redis://localhost:6379/0

# ==============================
# BOT SETTINGS
# ==============================
# Scan interval en secondes
SCAN_INTERVAL=3

# Montant max par trade en USDC
MAX_TRADE_AMOUNT=50.0

# Taux de win minimum pour copier un wallet (0.0 - 1.0)
MIN_WIN_RATE=0.70

# Nombre minimum de trades pour considérer un wallet
MIN_TRADES_COUNT=15

# Seuil whale en USDC
WHALE_THRESHOLD=500.0

# Mode dry-run (True = pas de vrai trade, juste logs)
DRY_RUN=True

# ==============================
# RISK MANAGEMENT
# ==============================
# % max du capital par trade
MAX_POSITION_PCT=0.10

# Cote max pour copier (évite les marchés déjà résolus)
MAX_PRICE=0.90

# Cote min
MIN_PRICE=0.05
