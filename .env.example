# ============================================================
# PolyInsider Bot v2.0 — Configuration
# Copier en .env et remplir les valeurs
# ============================================================

# ── Polymarket ──────────────────────────────────────────────
PRIVATE_KEY=your_private_key_here
PROXY_WALLET=your_proxy_wallet_address
CHAIN_ID=137

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite:///./polyinsider.db
REDIS_URL=redis://localhost:6379/0

# ── Bot Core ────────────────────────────────────────────────
SCAN_INTERVAL=3
MAX_TRADE_AMOUNT=50.0
MIN_WIN_RATE=0.70
MIN_TRADES_COUNT=15
WHALE_THRESHOLD=500.0
DRY_RUN=true

# ── Risk Management ─────────────────────────────────────────
MAX_POSITION_PCT=0.10
MAX_PRICE=0.90
MIN_PRICE=0.05

# ── Conviction Filters (v2.0) ───────────────────────────────
# Taille minimale du bet source pour être copié (USDC)
MIN_SOURCE_BET_USDC=50.0
# Win rate minimum du wallet source (0.0-1.0)
MIN_WALLET_SCORE=0.65

# ── Arbitrage Cross-Platform (v2.0) ─────────────────────────
# Scanner Polymarket vs Kalshi — activer pour détecter l'arb
ARB_ENABLED=true
ARB_MIN_PROFIT_PCT=0.03

# ── Market Scanner (v2.0) ───────────────────────────────────
# Scan haute échelle de 5000+ marchés Polymarket
MARKET_SCAN_ENABLED=true
MARKET_SCAN_MAX_MARKETS=5000
MARKET_SCAN_EVERY_N_LOOPS=100

# ── LLM Agent (v2.0) — optionnel ────────────────────────────
# Désactivé par défaut. Activer avec LLM_ENABLED=true
LLM_ENABLED=false
# Clé OpenAI pour GPT-4o-mini (requis si LLM_ENABLED=true)
OPENAI_API_KEY=sk-...
# Clé NewsAPI pour enrichir le contexte (optionnel)
NEWS_API_KEY=
LLM_MIN_CONFIDENCE=0.75
LLM_SCAN_EVERY_N_LOOPS=50
LLM_TOP_MARKETS=5
