# ============================================================
# PolyInsider Bot v3.2 — Configuration
# Copier en .env et remplir les valeurs
# ============================================================

# ── Polymarket ────────────────────────────────────────
PRIVATE_KEY=your_private_key_here
PROXY_WALLET=your_proxy_wallet_address
CHAIN_ID=137

# ── Telegram ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./polyinsider.db
# Pour PostgreSQL: postgresql://user:pass@localhost:5432/polyinsider
REDIS_URL=redis://localhost:6379/0

# ── Bot Core ──────────────────────────────────────────
SCAN_INTERVAL=3
MAX_TRADE_AMOUNT=50.0
MIN_WIN_RATE=0.70
MIN_TRADES_COUNT=15
WHALE_THRESHOLD=500.0
DRY_RUN=true
INITIAL_CAPITAL=500.0

# ── Risk Management ───────────────────────────────────
MAX_POSITION_PCT=0.10
MAX_PRICE=0.90
MIN_PRICE=0.05

# ── Conviction Filters (v2.0) ─────────────────────────────
MIN_SOURCE_BET_USDC=50.0
MIN_WALLET_SCORE=0.65

# ── Wallet Management (v3.2) ──────────────────────────────
WALLET_WHITELIST=
WALLET_BLACKLIST=
# Auto-discovery activé par défaut
WALLET_DISCOVERY_ENABLED=true
WALLET_DISCOVERY_MIN_WINRATE=0.70
WALLET_DISCOVERY_MIN_VOLUME=5000.0

# ── Trailing Stop-Loss (v3.2) ─────────────────────────────
TRAILING_STOP_ENABLED=true
TRAILING_STOP_DISTANCE_PCT=0.15
TRAILING_LOCK_PROFIT_THRESHOLD=0.25
TRAILING_LOCK_PROFIT_STOP_PCT=0.10

# ── Rate Limiting (v3.2) ──────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BURST_SIZE=10

# ── Arbitrage Cross-Platform (v2.0) ─────────────────────────
ARB_ENABLED=true
ARB_MIN_PROFIT_PCT=0.03

# ── Market Scanner (v2.0) ─────────────────────────────────
MARKET_SCAN_ENABLED=true
MARKET_SCAN_MAX_MARKETS=5000
MARKET_SCAN_EVERY_N_LOOPS=100

# ── LLM Agent (v2.0) — optionnel ────────────────────────────
LLM_ENABLED=false
OPENAI_API_KEY=sk-...
NEWS_API_KEY=
LLM_MIN_CONFIDENCE=0.75
LLM_SCAN_EVERY_N_LOOPS=50
LLM_TOP_MARKETS=5

# ── API Server (v3.2) ─────────────────────────────────────
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*

# ── Backtest (v3.2) ───────────────────────────────────────
BACKTEST_DEFAULT_START_DATE=2025-01-01
BACKTEST_DEFAULT_END_DATE=2026-02-28
