# ============================================================
# PolyInsider Bot v3.2 — Configuration
# Copier en .env et remplir les valeurs
# ============================================================

# ── Polymarket ──────────────────────────────────────────────────────
PRIVATE_KEY=your_private_key_here
PROXY_WALLET=your_proxy_wallet_address
CHAIN_ID=137

# ── Telegram ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Database & Cache ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/polyinsider.db
# Redis pour smart caching (optionnel, fallback in-memory si absent)
# Pour installer: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379/0

# ── Bot Core ────────────────────────────────────────────────────────
SCAN_INTERVAL=3           # Polling interval (1-60s) — 1s = temps réel
MAX_TRADE_AMOUNT=50.0     # Max $ par trade copié
MIN_WIN_RATE=0.70         # Win rate minimum du wallet source
MIN_TRADES_COUNT=15       # Trades minimum pour scorer un wallet
WHALE_THRESHOLD=500.0     # Seuil baleines (USDC)
DRY_RUN=true              # true = simulation, false = LIVE TRADING

# ── Risk Management ───────────────────────────────────────────────────
MAX_POSITION_PCT=0.10     # Max 10% du capital par trade
MAX_PRICE=0.90            # Prix max (au-dessus = passé)
MIN_PRICE=0.05            # Prix min (en-dessous = passé)
MAX_POSITIONS=10          # Positions simultanées max
DAILY_LOSS_LIMIT_PCT=0.15 # Stop si -15% en 24h
DRAWDOWN_LIMIT_PCT=0.25   # Stop si -25% depuis le pic

# ── Position Sizing ────────────────────────────────────────────────────
KELLY_FRACTION=0.25        # Quarter-Kelly (conservateur)
CONVERGENCE_BOOST=1.5     # Boost si plusieurs insiders convergent
# Multiplicateurs dégressifs selon la taille du bet source
# Format: min-max:mult,min+:mult (USD)
# Ex: bet 100$ source → 30% Kelly, bet 10K$ → 1% Kelly
TIERED_MULTIPLIERS=1-50:1.0,50-500:0.3,500-5000:0.05,5000+:0.01

# ── Conviction Filters ──────────────────────────────────────────────────
MIN_SOURCE_BET_USDC=50.0  # Taille min du bet source
MIN_WALLET_SCORE=0.65     # Score min du wallet (win rate)
MAX_CONSECUTIVE_LOSSES=3  # Skip wallet après 3 pertes consécutives

# ── Wallet Whitelist / Blacklist ────────────────────────────────────────────
WALLET_WHITELIST=          # CSV (ex: 0xAAA,0xBBB) — force tracking
WALLET_BLACKLIST=          # CSV (ex: 0xCCC,0xDDD) — never copy

# ── Arbitrage Cross-Platform ──────────────────────────────────────────────
ARB_ENABLED=true
ARB_MIN_PROFIT_PCT=0.03   # Profit minimum pour alerter (3%)

# ── Market Scanner ─────────────────────────────────────────────────────
MARKET_SCAN_ENABLED=true
MARKET_SCAN_MAX_MARKETS=5000
MARKET_SCAN_EVERY_N_LOOPS=100  # Scan tous les 100 cycles (~5min)

# ── LLM Agent (optionnel) ─────────────────────────────────────────────────
LLM_ENABLED=false
OPENAI_API_KEY=sk-...     # Requis si LLM_ENABLED=true
NEWS_API_KEY=              # newsapi.org pour enrichir le contexte
LLM_MIN_CONFIDENCE=0.75
LLM_SCAN_EVERY_N_LOOPS=50  # Analyse tous les 50 cycles (~2.5min)
LLM_TOP_MARKETS=5

# ── Health Monitor ──────────────────────────────────────────────────────
HEALTH_SILENCE_THRESHOLD_MIN=30  # Alerte si 30min sans activité
HEALTH_CHECK_INTERVAL_SEC=300    # Vérifie tous les 5min
HEALTH_ALERT_COOLDOWN_MIN=60     # Cooldown entre alertes (anti-spam)

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO            # DEBUG pour voir les réponses API brutes
